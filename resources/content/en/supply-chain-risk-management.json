{
 "file": "13- Supply Chain Risk Management.docx",
 "title": "Supply Chain Risk Management",
 "duration": "3 Days",
 "overview": [
  "Effectively managing risks within a supply chain is an essential skill for any supply chain professional today. This course will equip procurement and supply chain professionals with the skills necessary to work diligently and effectively with their supply base, mitigating risks while maximizing opportunities to gain a competitive advantage in the marketplace."
 ],
 "audience": [
  "This course is intended for supply chain and logistics professionals, especially those at the operational, supervisory, and management levels. It is ideal for individuals looking to enhance their supply chain and logistics experience with risk management skills applicable to their daily operations."
 ],
 "methodology": [
  "The course is highly interactive, featuring group discussions, team exercises, case studies, individual and group presentations, videos, and summative quizzes."
 ],
 "competencies": [
  "Supply chain management",
  "Supply chain risk assessment",
  "Supply chain quality management",
  "Warehouse management",
  "Transportation management",
  "Procurement",
  "Logistics management"
 ],
 "objectivesIntro": [
  "By the end of the course, participants will be able to:"
 ],
 "objectives": [
  "Outline contemporary supply chain and risk management concepts as a foundation for operational success",
  "Plan the supply chain management risk process to align with organizational requirements",
  "Identify and assess sources of risk across the supply chain",
  "Evaluate risks qualitatively and quantitatively using a diverse toolkit",
  "Develop risk mitigation and contingency plans to ensure a steady supply flow",
  "Recognize cultural, ethical, and legal considerations in supply chain risk management planning"
 ],
