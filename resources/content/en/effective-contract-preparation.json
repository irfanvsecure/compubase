{
 "file": "5- Effective Contract Preparation.docx",
 "title": "Effective Contract Preparation",
 "duration": "5 Days",
 "overview": [
  "This course is designed to equip participants with the essential knowledge, concepts, and skills required to manage all tasks in the pre-award phase of a contract. It covers various contract types and contracting methods, including bidding, competitive proposals, and sole sourcing. Participants will gain a comprehensive understanding of the processes and activities involved in contract preparation, enabling them to develop effective and thorough contracts."
 ],
 "audience": [
  "This course is ideal for professionals involved in the pre-award phase of the contracting process, including those responsible for determining contracting strategies, sourcing decisions, and drafting contract provisions to ensure successful contract management."
 ],
 "methodology": [
  "The course utilizes individual and group exercises to reinforce learning of critical contract management activities. It also features case studies, role-playing, and participant presentations, followed by group discussions. Pre- and post-course assessments are conducted to track progress."
 ],
 "competencies": [
  "Contract preparation",
  "Drafting scope of work",
  "Planning the pre-award process",
  "Understanding the bidding process",
  "Navigating technical terms and conditions",
  "Negotiating contracts"
 ],
 "objectivesIntro": [
  "By the end of the course, participants will be able to:"
 ],
 "objectives": [
  "Identify the fundamental elements of contracting.",
  "Understand the key steps in contract preparation, including crafting an effective scope of work, terms, conditions, and sourcing strategy.",
  "Recognize different contract types and explore a range of contracting strategies, including pricing.",
  "Create a pre-award negotiation plan to achieve mutually beneficial outcomes.",
  "Apply evaluation criteria to select the most suitable contractors for a project."
