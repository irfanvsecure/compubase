 "title": "Middle Management Skills",
 "duration": "3 Days",
 "overview": [
  "Developing strong managerial and leadership skills is essential for driving personal and organizational success. This course is tailored to equip both new and seasoned managers with advanced skills that will enable them to deliver immediate value to their teams and organizations."
 ],
 "audience": [
  "This course is ideal for managers, senior supervisors, and professionals who seek to enhance their management and leadership capabilities through advanced techniques."
 ],
 "methodology": [
  "Participants will engage in individual and group debriefs to cultivate their leadership and management skills. The course incorporates case studies, participant presentations followed by group discussions, as well as videos and team exercises."
 ],
 "competencies": [
  "Leadership",
  "Performance management",
  "Problem-solving",
  "Influencing others",
  "Change management",
  "Coaching",
  "Conflict resolution"
 ],
 "objectivesIntro": [
  "By the end of the course, participants will be able to:"
 ],
 "objectives": [
  "Identify the key leadership and managerial skills necessary for boosting organizational productivity",
  "Implement effective coaching and appraisal methods",
  "Utilize problem-solving tools to address organizational challenges",
  "Resolve conflicts using win-win strategies",
  "Develop plans for managing change to achieve continuous improvement",
  "Create effective time management strategies"
 ],
