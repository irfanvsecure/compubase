{
 "file": "01- Preparation for Project Management Professional (PMP) Certification.docx",
 "title": "Preparation for Project Management Professional (PMP) Certification",
 "duration": "5 Days",
 "overview": [
  "This course is designed to prepare participants for the Project Management Professional (PMP) certification exam. It covers exam requirements, question formats, and offers extensive practice with exam-style questions. Participants will gain a deep understanding of the project life cycle through an in-depth exploration of the five process groups and ten knowledge areas essential to project management."
 ],
 "audience": [
  "Project managers, project office members, project sponsors, functional managers, senior management, and individuals pursuing PMP certification."
 ],
 "methodology": [
  "The course utilizes interactive methods, including group exercises, brief presentations, practice exam questions, and simulations"
 ],
 "competencies": [
  "Project Management",
  "Project Initiation",
  "Project Planning",
  "Project Execution",
  "Project Control",
  "Project Closure"
 ],
 "objectivesIntro": [
  "By the end of the course, participants will be able to:"
 ],
 "objectives": [
  "Review the PMP exam requirements and application process",
  "Define key terms and understand the relationships between portfolio, program, and project management",
  "Explain how organizational influences affect project management",
  "Integrate various processes and project management activities",
  "Breakdown project scope to encompass all required work",
  "Calculate activity durations and project timelines",
  "Estimate costs and develop project budgets",
  "Establish quality policies and objectives for the project",
  "Assemble and manage the project team effectively",
  "Develop a risk management plan and assess project risks",
  "Plan procurement for external products and services",
  "Analyze stakeholder expectations and their impact on the project"
 ],
