{
    "title": "Spanish Language – Level 05",
    "duration": "1 Month",
    "overview": [
        "This upper-intermediate Spanish course builds on Level 04 to strengthen independent communication in professional, academic, and social settings. Participants refine grammatical accuracy, interpret authentic spoken and written texts, articulate nuanced viewpoints, and produce well-organized presentations and correspondence. The course integrates guided practice, realistic scenarios, and ongoing feedback across listening, speaking, reading, and writing."
    ],
    "audience": [
        "Learners who have completed Spanish Language – Level 04 or possess comparable intermediate proficiency and wish to communicate with greater fluency, precision, and confidence in varied real-world contexts."
    ],
    "methodology": [
        "Interactive instructor-led sessions, task-based communication, authentic audio and reading materials, structured language workshops, role-plays, paired discussions, writing clinics, pronunciation coaching, formative quizzes, and a final integrated performance assessment."
    ],
    "competencies": [
        "Sustain clear, extended discussions and defend viewpoints with relevant evidence.",
        "Use upper-intermediate grammatical structures accurately and appropriately.",
        "Interpret key ideas, tone, and implied meaning in authentic Spanish materials.",
        "Produce coherent professional messages, reports, and presentations.",
        "Adapt register, vocabulary, and interaction strategies to context and audience."
    ],
    "objectivesIntro": [],
    "objectives": [
        "Narrate, compare, hypothesize, and evaluate events using appropriate tense and mood.",
        "Explain complex ideas and negotiate solutions in structured conversations.",
        "Summarize and critically respond to articles, interviews, and presentations.",
        "Write organized formal and semi-formal texts with effective cohesion.",
        "Deliver a confident presentation and respond constructively to questions."
    ],
