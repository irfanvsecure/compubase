 "title": "Business Decision Models",
 "duration": "5 Days",
 "overview": [
  "Managers frequently make decisions under conditions of certainty, risk, and uncertainty, yet many lack formal training in decision-making. This course equips participants with essential business decision models and techniques to enhance their decision-making quality, tailored to the specific conditions they encounter."
 ],
 "audience": [
  "Managers, department heads, and business professionals engaged in decision-making, planning, and strategy development for their departments and the organization."
 ],
 "methodology": [
  "The course employs a blend of interactive methods, including brief presentations by the instructor, case studies, and group exercises to apply the knowledge gained throughout the course."
 ],
 "competencies": [
  "Decision making",
  "Risk management",
  "Risk assessment",
  "Evaluation",
  "Budgeting",
  "Analytical thinking",
  "Financial decision making"
 ],
 "objectivesIntro": [
