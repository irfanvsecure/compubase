{
 "duration": "3 أيام",
 "overview": [
  "توفر المقابلات القائمة على الكفاءة طريقة منظمة لتقييم ما إذا كان المرشحون قد أظهروا السلوكيات والقدرات والحكم المطلوب للأداء الناجح في أحد الأدوار. وبدلاً من الاعتماد على الانطباعات العامة أو الإجابات الافتراضية وحدها، يستخدم هذا النهج أدلة من سلوك المرشحين السابقين ويطبق معايير متسقة لتحسين جودة قرارات الاختيار وعدالتها وإمكانية الدفاع عنها.",
  "تزود هذه الدورة التدريبية التي تستمر ثلاثة أيام القائمين على المقابلات بالمهارات العملية اللازمة لترجمة متطلبات الدور إلى كفاءات، وتطوير الأسئلة السلوكية، والتحقيق بفعالية، وتقييم الأدلة، وتدوين ملاحظات مفيدة للمقابلة، وتطبيق معايير التصنيف، وتقليل التحيز، والوصول إلى قرارات التوظيف القائمة على الأدلة.",
  "من خلال محاكاة المقابلات، وتمارين تصميم الأسئلة، وحالات تصنيف الأدلة، وممارسة التحقيق، وأنشطة اتخاذ القرار من قبل اللجنة، يطور المشاركون نهجًا منضبطًا لإجراء المقابلات يدعم مقارنة أفضل بين المرشحين مع الحفاظ على تجربة المرشح المهنية."
 ],
 "audience": [
  "مديرو الموارد البشرية والمتخصصون، ومتخصصو التوظيف واكتساب المواهب، ومديرو التوظيف، ورؤساء الأقسام، والمشرفون، وأعضاء لجنة المقابلة، وشركاء أعمال الموارد البشرية، والموظفين المشاركون في تقييم المرشحين، أو اختيارهم، أو ترقيتهم، أو مقابلات التعيين الداخلية."
 ],
 "methodology": [
  "تستخدم الدورة منهجية تطبيقية تجمع بين العروض التقديمية القصيرة، وتمارين تحليل الكفاءة، وتصميم الأسئلة السلوكية، وعروض المقابلات، وممارسة التحقيق المنظمة، وتحليل استجابة المرشحين، وتمارين تدوين الملاحظات، وأنشطة التقييم والمعايرة، ومحاكاة المقابلات، وحالات اتخاذ القرار من قبل اللجنة، وتعليقات الأقران، وتخطيط العمل."
 ],
