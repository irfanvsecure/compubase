{
 "duration": "3 أيام",
 "overview": [
  "وتقتضي الميزة التنافسية المستدامة من المنظمات أن تتفهم المكان الذي تتجه فيه المنافسة، وأن تتخذ خيارات استراتيجية مدروسة، وأن تخلق قيمة بطرق يصعب الحد منها. ولا يمكن أن يؤدي التنافس إلا على العوامل الصناعية القائمة إلى ضغط الأسعار، والتحسين التدريجي، والتشابه الاستراتيجي. ويتحدى الابتكار في القيمة المنظمات الرامية إلى إعادة النظر في قيمة العملاء وأصحاب المصلحة وإعادة تصميم مزيج من الفوائد والتكاليف والخبرات والقدرات التي تحدد موقعها التنافسي.",
  "وتتيح هذه الدورة التي تستغرق ثلاثة أيام للمديرين والمهنيين المعنيين بالاستراتيجية أطرا عملية لتحليل البيئات التنافسية، وفهم مصادر الميزة، وتحديد الثغرات الاستراتيجية، وتقييم المنافسين، وقيمة التجزئة، وخلق مواقف استراتيجية متباينة. وسيستكشف المشاركون أيضا مبادئ الابتكار القيمي، والتفتيشات الاستراتيجية، وإطار القضاء على الإقلال من التعريفات، والتحليلات غير المتعلقة بالمتهمين، والخيارات النموذجية للأعمال، وترجمة الأفكار الاستراتيجية إلى مبادرات قابلة للتنفيذ.",
  "ومن خلال عمليات التحليل التنافسي، ودراسات الحالات الإفرادية، ورسم الخرائط الاستراتيجية، وتطوير القيمة، وتقييم الخيارات، والتخطيط للتنفيذ، سيتعلم المشاركون الانتقال من فهم السوق إلى خيارات استراتيجية واضحة تخلق قيمة مميزة وقابلة للدفاع."
 ],
 "audience": [
  "كبار المديرين، ورؤساء الإدارات، واخصائيي الاستراتيجيات والتخطيط، ومديري تنمية الأعمال التجارية، ومديري التسويق، وزعماء المنتجات والخدمات، ومديرو الابتكار، والمهنيين في مجال التحول، وقادة وحدات الأعمال التجارية، والمديرين المشاركين في تحديد المواقع التنافسية، أو النمو، أو التخطيط الاستراتيجي، أو إنشاء القيمة."
 ],
 "methodology": [
  "وتستخدم الدورة منهجية مطبقة تجمع بين العروض القصيرة، وحالات الاستراتيجيات التنافسية، وتحليل الصناعة والمنافسين، ورسم الخرائط للمجموعات الاستراتيجية، وتحليل تقييم العملاء، وعمليات مسح البيانات الاستراتيجية، وتنمية القيمة، وحلقات العمل التي تُخفض فيها أسعار المنتجات، والتحليل غير التجاري، وتقييم الاعتماد الاستراتيجي، ومناقشة المجموعات، والتخطيط للتنفيذ. ويطبق المشاركون الأدوات على الأوضاع التنظيمية والسوقية الواقعية."
 ],
