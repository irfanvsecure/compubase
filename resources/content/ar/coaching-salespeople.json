{
 "duration": "3 أيام",
 "overview": [
  "إن تدريب المبيعات هو مسؤولية قيادية أساسية تُحسِّن سلوكيات البيع، وتبني القدرات، وتدعم الأداء التجاري المتسق. فالتدريب الفعّال للمبيعات يتجاوز التحقق من الأهداف أو إعطاء التعليمات: فهو يستخدم المراقبة، والتشكيك، والتغذية المرتدة، والممارسة، والمتابعة لمساعدة المبيعات على وضع حكمها وتنفيذها.",
  "وتوفر هذه الدورة التي تستغرق ثلاثة أيام لمديري المبيعات وقادة الأفرقة نهجاً عملياً منظماً لتدريب الأفراد على امتداد دورة المبيعات. ويتعلم المشتركون تشخيص الثغرات في الأداء، والتمييز بين التدريب وإدارة الأداء، وإجراء عمليات إنتاجية من جهة، ومراقبة التفاعلات مع العملاء، واستخدام بيانات المبيعات على النحو المناسب، وتطوير مهارات محددة، ومواصلة تحسين السلوك.",
  "وتستخدم الدورة حالات مبيعات واقعية، ودوراً في التدريب، واستعراضات خطوط الأنابيب، وعمليات مراقبة المكالمات، وخططاً تدريبية فردية لمساعدة المشاركين على تحويل نشاط المبيعات اليومي إلى فرص للتعلم وتحسين الأداء القابل للقياس."
 ],
 "audience": [
  "مديرو المبيعات، والمشرفون على المبيعات، وقادة الأفرقة، ومديرو المبيعات على الصعيدين الإقليمي والفني، ومديرو تطوير الأعمال، وقادة أفرقة الحسابات الرئيسية، ومديرو المبيعات الميدانية، وزعماء المبيعات داخل المبيعات، وخبروا المهنيين في المبيعات الذين يستعدون لتدريب الآخرين."
 ],
 "methodology": [
  "عروض تفاعلية، تيسير المناقشة، وتحليل حالات أداء المبيعات، وتدريب المظاهرات، وعمليات الاستجواب المنظمة، ومراقبة أسعار المبيعات، والدورات، وممارسة التغذية المرتدة، وتدريب الأقران، وعمليات محاكاة استعراض الأنابيب، وخطط عمل التدريب العملي."
 ],
