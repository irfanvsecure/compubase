{
 "duration": "5 أيام",
 "overview": [
  "إدارة الأداء الفعالة هي عملية إدارية مستمرة تربط الأولويات التنظيمية بالمساهمة الفردية، وتحدد توقعات واضحة، وتقيس نتائج ذات معنى، وتدعم تطوير الموظفين، وتعالج فجوات الأداء قبل أن تصبح مشاكل مستمرة.",
  "توفر هذه الدورة التي تستغرق خمسة أيام للمديرين ومتخصصي الموارد البشرية إطارًا عمليًا لتحديد أهداف الأداء، وتطوير مؤشرات الأداء الرئيسية ذات الصلة، وتحديد الأهداف، وتتبع التقدم، وإجراء محادثات الأداء، وتقديم تعليقات بناءة، وتدريب الموظفين، وإدارة الأداء الضعيف، وإجراء مراجعات الأداء العادلة.",
  "ويؤكد البرنامج على إدارة الأداء كدورة مستمرة وليس كحدث تقييم سنوي. من خلال تمارين تصميم مؤشرات الأداء الرئيسية، وحالات الأداء، ومحاكاة ردود الفعل، وممارسة التدريب، ومناقشات المعايرة، وتخطيط العمل، يتعلم المشاركون كيفية خلق قدر أكبر من الوضوح والمساءلة والعدالة وتحسين أداء الموظفين."
 ],
 "audience": [
  "المديرون والمشرفون وقادة الفرق ورؤساء الأقسام ومديرو الموارد البشرية والمتخصصون وشركاء أعمال الموارد البشرية ومتخصصو إدارة الأداء ومتخصصو إدارة المواهب والموظفين المسؤولون عن تحديد الأهداف وقياس الأداء وتقديم التعليقات وتدريب الموظفين أو إجراء مراجعات الأداء."
 ],
 "methodology": [
  "تستخدم الدورة منهجية تطبيقية تجمع بين العروض التقديمية القصيرة، وحالات إدارة الأداء، وورش عمل تحديد الأهداف، وتمارين تصميم مؤشرات الأداء الرئيسية، وأنشطة تحديد الأهداف، ولوحة المعلومات وتمارين مراجعة التقدم، ولعب أدوار التغذية الراجعة، ومحاكاة التدريب، ومحادثات الأداء الصعبة، وحالات التقييم والمعايرة، والمناقشة الجماعية، وتخطيط العمل الفردي."
 ],
