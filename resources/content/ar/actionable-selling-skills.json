{
 "duration": "3 أيام",
 "overview": [
  "ويتوقف البيع الفعال على تحويل محادثات العملاء إلى إجراءات واضحة ومفيدة تدفع إلى اتخاذ قرار شراء حقيقي. ويجب على المهنيين العاملين في مجال البيع أن يفهموا احتياجات العملاء، وأن يقيموا الثقة، وأن يبلغوا القيمة، وأن يتعاملوا مع الشواغل، وأن يكفلوا اتخاذ خطوات مجدية في المستقبل دون الاعتماد على الضغوط أو على نصوص المبيعات العامة.",
  "وتضع هذه الدورة العملية التي تستغرق ثلاثة أيام المهارات الأساسية المستخدمة طوال دورة المبيعات، من الإعداد والتنقيب إلى الاكتشاف، وعرض الحلول، ومناولة الاعتراضات، والتفاوض، والاختتام، والمتابعة. وهو يشدد على السلوكات المتكررة، وإدارة الفرص المتأصلة، وتحسين قابل للقياس في أداء البيع اليومي.",
  "ويمارس المشاركون تفاعلات واقعية مع العملاء، ويبنيون مهارات الاستجواب والاستماع، ويصقلون عروض القيمة، ويتعاملون مع اعتراضات المبيعات المشتركة، ويضعون خطط عمل شخصية لتطبيقها فورا في أدوارهم."
 ],
 "audience": [
  "ومسؤولو المبيعات، وممثلو المبيعات، وأخصائيو تطوير الأعمال التجارية، ومديرو الحسابات، وموظفو المبيعات بالتجزئة والمبيعات الميدانية، وأخصائيو المبيعات عن بُعد، وعاملو الموظفين الذين يتقاضون مسؤوليات عن المبيعات، وبيعات جديدة أو ذات خبرة تسعى إلى إدخال تحسينات عملية في مجال البيع الفعال."
 ],
 "methodology": [
  "عروض تفاعلية، تيسير المناقشات، والمظاهرات المتعلقة بالمبيعات، والسيناريوهات المتعلقة بالزبائن، والدورات، والمقابلات الاكتشافية، وحفر المناولة، وعمليات محاكاة التفاوض، وارتداد الأقران، وتحليل حالات البيع، وخطط عمل البيع الفردية. ويمارس المشاركون مراراً وتكراراً ويتلقىون تعليقات على سلوكيات البيع الجديرة بالملاحظة."
 ],
