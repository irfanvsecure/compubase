{
 "duration": "5 أيام",
 "overview": [
  "فالتخطيط الاستراتيجي لا يولد قيمة إلا عندما يؤدي إلى خيارات واضحة، وإجراءات منسقة، ونتائج قابلة للقياس، وتنفيذ منضبط. وكثيراً ما تستثمر المنظمات جهداً كبيراً في وضع خطط استراتيجية، ولكنها تكافح من أجل ترجمة الطموحات الواسعة إلى أولويات ومبادرات وملكية وموارد وتدابير أداء وروتينات إدارية تحافظ على التنفيذ.",
  "وتوفر هذه الدورة التي تستغرق خمسة أيام إطارا عمليا كاملا للانتقال من التحليل الاستراتيجي ووضع التوجيهات إلى التنفيذ واستعراض الأداء. وسيبحث المشاركون التحليل البيئي، وتوقعات أصحاب المصلحة، والرؤية والمهمة، والأهداف الاستراتيجية، والخيارات الاستراتيجية، وتصور السيناريوهات، وتصميم المبادرات، وتحديد الأولويات، ووضع المعايير المحاسبية الدولية للقطاع العام، ومواءمة الموارد، والمخاطر، والحوكمة، والاتصال، والانضباط في التنفيذ، والاستعراض الاستراتيجي.",
  "ويرتكز البرنامج على حلقات العمل ويمكِّن المشاركين من بناء العناصر الرئيسية للخطة الاستراتيجية خطوة خطوة خطوة. وبحلول نهاية الدورة، لن يتفهم المشاركون كيفية صياغة الاستراتيجية فحسب، بل أيضا كيفية تحويلها إلى خارطة طريق قابلة للتنفيذ تدعمها المساءلة الواضحة، وتدابير الأداء، وآليات الاستعراض، والإجراءات التصحيحية."
 ],
 "audience": [
  "كبار المديرين، والمديرين، ورؤساء الإدارات، وأخصائيي الاستراتيجيات والتخطيط، وقادة المؤسسات التجارية، ومديري المشاريع والبرامج، وقادة التحول، والمهنيين في إدارة الأداء، ومديري القطاع العام، والمهنيين المسؤولين عن وضع الاستراتيجية التنظيمية أو ترجمة تلك الاستراتيجية أو تنفيذها أو رصدها أو استعراضها."
 ],
 "methodology": [
  "وتستخدم الدورة منهجية مطبقة تجمع بين العروض القصيرة، وعمليات التحليل الاستراتيجي، ودراسات الحالات الإفرادية، ورسم خرائط أصحاب المصلحة، والمسح البيئي، وتحليلات SWOT و TOWS، وعمليات السيناريوهات، وحلقات العمل لتحديد الأهداف، ورسم خرائط الاستراتيجيات، وتحديد أولويات المبادرات، وتصميم عملية كيمبرلي، وتخطيط التنفيذ، وتحليل المخاطر، وعمليات محاكاة استعراض الأداء، ومناقشة المجموعات، وتخطيط العمل. ويضع المشاركون تدريجياً إطاراً متكاملاً من الاستراتيجية إلى التنفيذ يقوم على تحديات تنظيمية واقعية."
 ],
