{
 "duration": "3 أيام",
 "overview": [
  "وتتطلب إدارة التجزئة الناجحة الإدارة المنسقة للعملاء، والناس، والسلع، والعمليات، والمخزون، وأداء المبيعات، والخبرة العامة في المخازن. ويجب أن يحقق مديرو التجزئة أهدافا تجارية مع الحفاظ على معايير الخدمات، والانضباط التشغيلي، وتوافر المنتجات، وإنتاجية الموظفين، وتجربة تجارية متسقة.",
  "وتوفر هذه الدورة التي تستغرق ثلاثة أيام لمديري التجزئة والمشرفين إطارا عمليا لإدارة أداء المخازن. ويدرس المشاركون استراتيجية التجزئة، وسلوك العملاء، وعمليات المخازن، والتداول بالبضائع ومراقبة المخزون، والتبريد البصري، وتحويل المبيعات، ونوعية الخدمات، وقيادة الأفرقة، والبرمجة، ومنع الخسائر، ووضع معايير التجزئة، وتحسين الأداء.",
  "ومن خلال حالات التجزئة، وعمليات أداء المخازن، وتحليل عملية كيمبرلي، والسيناريوهات التجارية، وحالات خدمة العملاء، وأنشطة التوظيف، وتخطيط العمل، يتعلم المشاركون كيفية إدارة بيئة التجزئة على نحو منهجي وتحسين خبرة العملاء والنتائج التجارية على حد سواء."
 ],
 "audience": [
  "مديرو التجزئة، ومديرو المخازن، ومديرو المخازن المساعدون، ومشرفو التجزئة، ومديرو الإدارات، ومديرو المناطق والفروع، ومهنيون عمليات التجزئة، ومشرفو المبيعات، ومهنيون في مجال البضائع، وموظفو التحضير لمسؤوليات إدارة التجزئة."
 ],
 "methodology": [
  "وتستخدم الدورة منهجية مطبقة تجمع بين العروض القصيرة، وحالات إدارة التجزئة، وتحليل أداء المخازن، وتمارين بيع الزبائن، والسيناريوهات المتعلقة بالبضائع والمخزونات، وأنشطة الميكانيكية البصرية، والتوظيف والتصنيف، ومحاكاة المبيعات والخدمات، وتحليلات عملية كيمبرلي، وحالات منع الخسائر، والمناقشات الجماعية، وتخطيط العمل الفردي."
 ],
