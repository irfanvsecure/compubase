{
 "duration": "3 أيام",
 "overview": [
  "غالبًا ما تكون مراكز الاتصال ومراكز الاتصال إحدى أكثر نقاط التفاعل وضوحًا بين المؤسسة وعملائها. يمكن أن تؤثر كل مكالمة على ثقة العملاء ورضاهم وولائهم وسمعة المنظمة. ولذلك يتطلب الوكلاء الفعالون أكثر من مجرد آداب الهاتف: يجب عليهم الجمع بين التواصل والاستماع والاستجواب والتحكم في المكالمات والحكم على خدمة العملاء وحل المشكلات والتوثيق الدقيق والإدارة الذاتية العاطفية والالتزام المستمر بمعايير الخدمة.",
  "تزود هذه الدورة المشاركين بالمهارات الأساسية وممارسات التشغيل المطلوبة للعمل الاحترافي في مراكز الاتصال الواردة والصادرة. ويغطي دورة الاتصال الكاملة، والصوت واللغة، والاستماع النشط، وتحديد الاحتياجات، والتحكم في المكالمات، ومعالجة الاستفسارات والشكاوى والمتصلين الصعبين، والتعليق والتحويلات، وحل جهة الاتصال الأولى، والتصعيد، والمكالمات الصادرة، والتوثيق، والإنتاجية، ومعايير الجودة، ومقاييس أداء مركز الاتصال الرئيسية.",
  "البرنامج عملي للغاية ويستخدم محاكاة المكالمات، وتمثيل الأدوار، وتمارين الاستماع، وممارسة تدفق المكالمات، وسيناريوهات العملاء الصعبة، وتمارين التوثيق، ومراجعات الجودة، وملاحظات الأداء. سيقوم المشاركون بتطوير نهج منظم لإدارة المكالمات بكفاءة مع الحفاظ على الدقة والكفاءة المهنية وتجربة العملاء الإيجابية."
 ],
 "audience": [
  "وكلاء مراكز الاتصال ومركز الاتصال الجدد والحاليين، وممثلو خدمة العملاء، وموظفو مكتب المساعدة، وموظفو الخدمة عن بعد، وموظفو دعم المبيعات عبر الهاتف، وموظفو الاستقبال ولوحة التبديل، ومنسقو الخدمة، والموظفين الذين تتضمن أدوارهم مكالمات العملاء الواردة أو الصادرة بشكل متكرر. الدورة مناسبة أيضًا لقادة الفرق المبتدئين الذين يحتاجون إلى فهم عملي لمعايير مراكز الاتصال في الخطوط الأمامية."
 ],
 "methodology": [
  "تستخدم الدورة منهجية تفاعلية قائمة على الممارسة تجمع بين العروض التقديمية القصيرة، ومحاكاة المكالمات الواردة والصادرة، وتمارين الصوت والنغمة، وتدريبات الاستماع النشط، وممارسة طرح الأسئلة، ومحاكاة تدفق المكالمات، وسيناريوهات الانتظار والتحويل، ولعب أدوار الشكوى والمتصل الصعب، وتمارين توثيق الحالة، وأنشطة مراقبة الجودة، وتعليقات الأقران، وتدريب المدربين، وتخطيط العمل الشخصي. ويتم التركيز على الممارسة المتكررة وردود الفعل الفورية."
 ],
