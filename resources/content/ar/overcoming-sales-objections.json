{
 "duration": "3 أيام",
 "overview": [
  "وتشكل اعتراضات المبيعات جزءا طبيعيا من عملية اتخاذ قرارات العملاء. ويمكن أن تعكس شواغل حقيقية بشأن القيمة، أو التكلفة، أو التوقيت، أو الملاءمة، أو التنفيذ، أو الثقة، أو مخاطر التغيير. ولا يعامل الأخصائيون الناشطون في مجال المبيعات كل اعتراض على أنه مقاومة للهزيمة؛ وهم يحققون في قضيته الأساسية، ويستجيبون بالأدلة ذات الصلة، ويساعدون العملاء على التوصل إلى قرارات مستنيرة.",
  "وتضع هذه الدورة التي تستغرق ثلاثة أيام نهجاً استشارياً منظماً لتوقع وتوضيح وتسوية الاعتراضات عبر عملية المبيعات. ويتعلم المشاركون التمييز بين الاعتراضات من الظروف والفرائس، والاستماع دون الدفاع، وتشخيص شواغل العملاء، والارتباط بالقيمة، والاستجابة لضغط الأسعار، وإدارة البدائل المتنافسة، والتأكيد على ما إذا كانت الشواغل قد حُلّت.",
  "ومن شأن السيناريوهات العملية، وثقاب الاستجواب، والدورات، وتحليل الحالات، وعمليات المحاكاة التي تعالج الاعتراضات، أن تساعد المشاركين على تعزيز الثقة مع الحفاظ على الثقة، واختيار العملاء، والقيمة التجارية."
 ],
 "audience": [
  "وممثلو المبيعات، ومديرو الحسابات، ومهنيون في مجال تنمية الأعمال التجارية، والبيع بالتجزئة وفي الميدان، وأفرقة المبيعات عن بُعد، وأفرقة المبيعات الداخلية، ومديرو الحسابات الرئيسية، ومشرفو المبيعات، والمديرون المسؤولون عن تدريب أفرقة المبيعات التي تؤدّي العملاء."
 ],
 "methodology": [
  "عروض تفاعلية، مناقشات مصحوبة بمرشدين، تحليل حالة العملاء، عمليات تصنيف الاعتراض، مثقاب الاستجواب والاستماع، حلقات عمل بشأن عرض القيمة، محاكاة تحديد الأسعار، الأدوار المقترنة، تعليقات الأقران، تخطيط تحسين المبيعات الشخصية."
 ],
