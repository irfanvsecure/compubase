{
 "duration": "3 أيام",
 "overview": [
  "ويتطلب البيع الاستراتيجي من المهنيين في مجال البيع أن يتجاوزوا عرض المنتجات وإقناع المعاملات نحو فهم أعمق لأولويات العملاء، وديناميات اتخاذ القرارات، والبدائل التنافسية، وخلق القيمة، والفرص التجارية الطويلة الأجل. ويضيف الاختراق في البيع القدرة على تحدي النُهج التقليدية، وتكشف الاحتياجات الخفية، وتخلق قيمة متفاوتة، وتسخير الفرص التي قد تظل، لولا ذلك، متوقفة أو مخففة.",
  "وتزود هذه الدورة التي تستغرق ثلاثة أيام مهنيي المبيعات والمديرين بأساليب عملية لاختيار وترتيب الأولويات، وحسابات البحث، وتحديد صانعي القرار والمؤثرين، وتشخيص احتياجات العملاء، ووضع عروض قيمة قاهرة، وإدارة المواقف التنافسية، والتعامل مع الاعتراضات، والقيمة التفاوضية، ووضع استراتيجيات تأديبية للفرص.",
  "ومن خلال حالات الحسابات، وممارسة الاستجواب، ورسم خرائط أصحاب المصلحة، وعمليات عرض القيمة، وعمليات محاكاة الاعتراض، والسيناريوهات التفاوضية، وتخطيط الفرص، يضع المشاركون نهجا أكثر استراتيجية وتركيزا تجاريا لفوز فرص المبيعات المعقدة."
 ],
 "audience": [
  "مديرو المبيعات، ومديرو تنمية الأعمال التجارية، ومديرو الحسابات الرئيسية، ومديرو الحسابات، وكبار المهنيين في مجال المبيعات، ومديري العلاقات، والمهنيين العاملين في مجال تسوية المنازعات، والمديرين التجاريين، والموظفين المسؤولين عن تطوير أو إدارة أو كسب فرص عملاء كبيرة."
 ],
 "methodology": [
  "وتستخدم الدورة منهجية مطبقة تجمع بين العروض القصيرة، وحالات المبيعات، وتحليل الحسابات والفرص، ورسم خرائط أصحاب المصلحة، وعمليات الاستجواب والاستماع، وتطوير عرض القيمة، وأنشطة الطرح التنافسي، وعمليات محاكاة معالجة الاعتراض، وممارسة التفاوض، ودور الأدوار، وتعليقات الأقران، والتخطيط الاستراتيجي للفرصة."
 ],
