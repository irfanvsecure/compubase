{
 "duration": "5 أيام",
 "overview": [
  "وعلى مستويات القيادة العليا، لا تكفي الخبرة التقنية والسلطة الوظيفية لخلق تأثير مستمر. ويعمل القادة في بيئات تتشكل من الضغط، والغموض، والمصالح المتنافسة، والسياسة التنظيمية، والقرارات الصعبة، والشخصيات القوية، والتغير المدفوع عاطفيا. وتصبح قدرتهم على فهم أنفسهم وتنظيمهم في الوقت الذي يقرأون فيه بدقة ويؤثرون فيه على الآخرين ميزة قيادية بالغة الأهمية.",
  "ويطبق هذا البرنامج المتقدم الذي يستغرق خمسة أيام الذكاء العاطفي على حقائق القيادة التنفيذية والقيادة العليا. ويدرس المشاركون الوعي الذاتي، والتنظيم الذاتي العاطفي، والوجود التنفيذي، والتعاطف، والوعي الاجتماعي، وإدارة العلاقات، والنفوذ، والنـزاع، والمحادثات الصعبة، واتخاذ القرارات تحت الضغط، والمناخ التنظيمي، والقدرة على التكيف، وقيادة التغيير الذكية عاطفيا.",
  "ويجمع هذا المسار بين التفكير والتطبيق المكثف للقيادة. ومن خلال عمليات التقييم، وحالات القيادة، والتمارين السلوكية، والمحادثات الصعبة، والسيناريوهات المتعلقة بالجهات صاحبة المصلحة، وممارسات التغذية المرتدة، وتخطيط العمل، يضع المشاركون أساليب عملية لاستخدام الذكاء العاطفي لتعزيز الحكم، والثقة، والنفوذ، وأداء الفريق، وتأثير القيادة."
 ],
 "audience": [
  "كبار المسؤولين التنفيذيين والمديرين ورؤساء الإدارات وكبار المديرين ورؤساء مؤسسات الأعمال، وقادة المؤسسات التجارية، وقادة كبار المسؤولين، وقادة التحول، ومديري المشاريع والبرامج، والمديرين ذوي الخبرة الذين تتطلب أدوارهم حكماً متقدماً فيما بين الأشخاص، وتأثيراً، وصنع القرار، وإدارة النزاعات، وإشراك أصحاب المصلحة، وقيادة تحت الضغط."
 ],
 "methodology": [
  "والهدف من هذا البرنامج هو استخدام منهجية للتعلم التنفيذي تجمع بين المدخلات المفاهيمية القصيرة، والتقييم الذاتي للفكر العاطفي، والتفكير المرشد، ودراسات الحالات المتعلقة بالقيادة، والمراقبة السلوكية، وتحليل أصحاب المصلحة، وعمليات الاتصال التنفيذية، وعمليات المحاكاة للخلافات الصعبة، وتصورات النـزاعات، وممارسات التدريب، وعمليات صنع القرار، والتغذية المرتدة من الأقران، وتخطيط العمل الفردي. وينصب التركيز على ترجمة الذكاء العاطفي إلى سلوك قيادي جدير بالملاحظة والقرارات العملية في أماكن العمل."
 ],
