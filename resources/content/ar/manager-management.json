{
 "duration": "3 أيام",
 "overview": [
  "ويختلف المديرون الإداريون اختلافاً جوهرياً عن الإشراف على فرادى المساهمين. ويقتضي هذا الدور من القادة تحقيق النتائج من خلال قادة آخرين، وتحقيق المواءمة بين الأفرقة، وتعزيز المساءلة الإدارية، وتطوير القدرات الإدارية، وتنسيق الأولويات، وكفالة ترجمة المعايير التنظيمية بصورة متسقة إلى ممارسة قيادية يومية.",
  "وتزود هذه الدورة كبار المديرين، ورؤساء الإدارات، وقادة المديرين بأساليب عملية لتوجيه ودعم وتحدي وتطوير المديرين الذين يقدمون تقاريرهم إليهم. ويدرس المشاركون وضوح الدور، والوفد، والمساءلة، وإدارة الأداء، والتوجيه، وحقوق القرار، والتنسيق بين الوظائف، والاتصال الإداري، والصراع، والخلافة، وخلق ثقافة إدارية قوية.",
  "ويركز البرنامج على الانتقال من حل المشاكل التشغيلية شخصيا إلى بناء طبقة قادرة من المديرين الذين يمكن أن يقودوا بشكل مستقل. ومن خلال حالات القيادة، وتمارين الوفود، والسيناريوهات التدريبية، ومناقشات الأداء، وأدوات المساءلة، وتخطيط العمل، سيضع المشاركون نهجا منظما لتحسين أداء المديرين والأفرقة التي يقودونها."
 ],
 "audience": [
  "كبار المديرين، والمديرين، ورؤساء الإدارات، ورؤساء دوائر الأعمال، والرؤساء التنفيذيين، والمديرين العامين، والمديرين ذوي الخبرة الذين يشرفون على المديرين الآخرين أو قادة الأفرقة، والقادة ذوي القدرات العالية الذين يستعدون لتولي المسؤولية عن أفرقة متعددة أو طبقات إدارية."
 ],
 "methodology": [
  "وتستخدم الدورة منهجية قيادية مطبقة تجمع بين العروض القصيرة، ودراسات الحالات الإفرادية الإدارية، وتمارين توضيح الأدوار، وأنشطة التفويض وحقوق القرار، والسيناريوهات المتعلقة بإدارة الأداء، وعمليات المحاكاة التدريبية، ومناقشات المساءلة، وحل المشاكل عبر الوظائف، وممارسات التضارب الصعب، والتغذية المرتدة من الأقران، وتخطيط العمل الفردي. ويطبق المشاركون المفاهيم على التحديات الواقعية التي ينطوي عليها كبار المديرين بدلا من فرادى المساهمين."
 ],
