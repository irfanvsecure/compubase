{
 "duration": "3 أيام",
 "overview": [
  "تظل التفاعلات الهاتفية جزءًا مهمًا من خدمة العملاء لأن العميل يشكل انطباعًا عن المنظمة بشكل كامل تقريبًا من خلال صوت الموظف ولغته وقدرته على الاستماع والثقة والدقة والاستجابة. بدون إشارات بصرية، يمكن لنقاط الضعف الصغيرة في النبرة أو الوضوح أو الاستجواب أو إجراءات التعليق أو التحويلات أو إغلاق المكالمة أن تؤدي بسرعة إلى الارتباك وعدم الرضا.",
  "تعمل هذه الدورة على تطوير مهارات الهاتف المهنية المطلوبة لإنشاء تفاعلات إيجابية وفعالة تركز على العملاء. سيتعلم المشاركون كيفية الاستعداد للمكالمات، وخلق انطباع أول قوي، واستخدام الصوت بفعالية، والاستماع بنشاط، وطرح أسئلة هادفة، والتحكم في المحادثات وتنظيمها، وتوفير معلومات واضحة، وإدارة عمليات الحجز والتحويلات، وتلقي رسائل دقيقة، والتعامل مع الشكاوى والمتصلين الصعبين، وإغلاق المكالمات بشكل احترافي.",
  "يركز البرنامج على التطبيق العملي من خلال سيناريوهات الهاتف، وتمارين الصوت والاستماع، وممارسة بنية المكالمة، ومحاكاة المتصل الصعب، وأنشطة تلقي الرسائل، ومراجعة جودة المكالمة. سيقوم المشاركون بتطوير نهج هاتفي متسق يعزز الكفاءة المهنية وثقة العملاء وجودة الخدمة."
 ],
 "audience": [
  "ممثلو خدمة العملاء، ووكلاء مركز الاتصال ومركز الاتصال، وموظفو الاستقبال، وموظفو المكاتب الأمامية، والمساعدون الإداريون، وموظفو دعم المبيعات، وموظفو مكتب المساعدة، ومشغلو لوحات المفاتيح، ومنسقو الخدمة، وأي موظف يتواصل مع العملاء أو العملاء أو الموردين أو أفراد الجمهور عبر الهاتف."
 ],
 "methodology": [
  "تستخدم الدورة منهجية تفاعلية تجمع بين العروض التقديمية القصيرة، وتمثيل الأدوار الهاتفية، وتمارين الصوت والنغمة، وممارسة الاستماع النشط، وتدريبات طرح الأسئلة، ومحاكاة بنية المكالمة، وسيناريوهات الانتظار والتحويل، وتمارين تلقي الرسائل، ومحاكاة الشكوى والمتصل الصعب، ومراجعات جودة المكالمة، وتعليقات الأقران، وتخطيط العمل الشخصي. يتدرب المشاركون بشكل متكرر على المكالمات الواقعية حتى تصبح السلوكيات الهاتفية الاحترافية عملية ومتسقة."
 ],
