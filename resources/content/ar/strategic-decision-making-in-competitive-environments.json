{
 "duration": "3 أيام",
 "overview": [
  "وتتخذ القرارات الاستراتيجية في البيئات التي تكون فيها المعلومات غير كاملة، ويتصرف المنافسون، وتختلف مصالح أصحاب المصلحة، وقد تتغير الافتراضات، ويمكن أن تتجاوز نتائج الاختيارات بكثير النتائج التنفيذية الفورية. ومن ثم، فإن اتخاذ القرارات الاستراتيجية الفعالة يتطلب أكثر من التحليل؛ وهو يتطلب وضع حكم منضبط، وقائم على الأدلة، والوعي بعدم التيقن، وتوقع الاستجابة التنافسية، والقدرة على إجراء مقايضة واضحة.",
  "وتزود هذه الدورة التي تستغرق ثلاثة أيام المديرين وصانعي القرار بأطر عملية لاتخاذ قرارات ذات أثر كبير في بيئات تنافسية وغير مؤكدة. ويبحث المشاركون المشاكل الاستراتيجية، والتحليل البيئي والمنافس، ومعايير القرار، والبدائل، والسيناريوهات، وعدم التيقن، والمخاطر، والتحيز المعرفي، ومصالح أصحاب المصلحة، والاستجابة التنافسية، وتقييم الخيارات، والتنفيذ، والتعلم بعد اتخاذ القرار.",
  "ومن خلال حالات اتخاذ القرارات، وعمليات السيناريوهات، وعمليات المحاكاة التي تُجرى على الاستجابة التنافسية، وتقييم الخيارات، والتحقق من التحيز، وحلقات العمل المنظمة لاتخاذ القرارات، يتعلم المشاركون تحسين نوعية الخيارات الاستراتيجية، وتأديب عملية صنع القرار."
 ],
 "audience": [
  "كبار المديرين، والمديرين، ورؤساء الإدارات، وقادة أفرقة الأعمال، والمهنيين في مجال الاستراتيجيات والتخطيط، ومديري تطوير الأعمال التجارية، وقادة المشاريع والبرامج، ومديري التحول، والمهنيين المسؤولين عن القرارات ذات الأثر الكبير التي تنطوي على المنافسة، أو عدم اليقين، أو تخصيص الموارد، أو الأولويات الاستراتيجية، أو التوجيه التنظيمي."
 ],
 "methodology": [
  "وتستخدم الدورة منهجية مطبقة تجمع بين العروض القصيرة، وحالات القرارات الاستراتيجية، والتحليل التنافسي، وعمليات معالجة المشاكل، ووضع السيناريوهات، ومقاييس القرار، واختبار الافتراض، وتحليل المخاطر، والتمرينات المعرفية، ورسم الخرائط لأصحاب المصلحة، وعمليات المحاكاة للاستجابة التنافسية، وعمليات اتخاذ القرارات الجماعية، وتخطيط العمل. ويطبق المشاركون الأدوات على خيارات وممارسات استراتيجية واقعية توثق المنطق وراء قراراتهم."
 ],
