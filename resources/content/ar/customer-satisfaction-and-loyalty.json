{
 "duration": "3 أيام",
 "overview": [
  "يتم إنشاء رضا العملاء وولائهم من خلال الجودة التراكمية لتجربة العميل وليس من خلال معاملة واحدة. إن المؤسسات التي تفهم توقعات العملاء، وتقدم باستمرار القيمة ذات الصلة، وتقلل من الجهد غير الضروري، وتستجيب بفعالية عند حدوث المشكلات، وتتعلم بشكل منهجي من ردود الفعل، تكون في وضع أفضل للاحتفاظ بالعملاء وبناء علاقات طويلة الأمد.",
  "توفر هذه الدورة للمشاركين إطارًا عمليًا لفهم وقياس وتحسين رضا العملاء وولائهم. ويستكشف توقعات العملاء، والقيمة المتصورة، ولحظات الحقيقة، ورحلات العملاء، ومحركات الرضا، وجودة الخدمة، والثقة، والاتصال العاطفي، ومعالجة الشكاوى، واسترداد الخدمة، وتعليقات العملاء، وسلوك الولاء، والاحتفاظ، واستخدام بيانات العملاء لتوجيه التحسين.",
  "سيقوم المشاركون بتطبيق المفاهيم من خلال تحليل تجربة العملاء، ورسم خرائط الرحلة، وتمارين قياس الرضا، وسيناريوهات الشكوى والاسترداد، وتحليل محرك الولاء، وتخطيط العمل. وينصب التركيز على تحويل رؤية العملاء إلى تحسينات عملية تعزز الرضا والاحتفاظ والدعوة والعلاقات المستدامة مع العملاء."
 ],
 "audience": [
  "مدراء وموظفي خدمة العملاء، ومتخصصو تجربة العملاء، وموظفو المبيعات وإدارة الحسابات، وفرق الفروع ومراكز الاتصال، ومتخصصو التسويق، وموظفو جودة الخدمة، ومديرو العمليات، والمشرفون، وقادة الفرق، والموظفون المسؤولون عن رضا العملاء، والاحتفاظ بهم، وولائهم، وإدارة الشكاوى، أو تحسين الخدمة."
 ],
 "methodology": [
  "تستخدم الدورة منهجية تفاعلية تجمع بين العروض التقديمية القصيرة، ودراسات حالة تجربة العملاء، وتحليل دوافع الرضا، ورسم خرائط رحلة العميل، وتمارين الشخصية والتوقعات، وسيناريوهات الشكوى واسترداد الخدمة، وتحليل تعليقات العملاء، وأنشطة القياس، وتمارين الولاء والاحتفاظ، والمناقشات الجماعية، وتخطيط العمل. سيقوم المشاركون بتطبيق الأدوات على مواقف العملاء الواقعية وتحديد التحسينات العملية ذات الصلة ببيئة الخدمة الخاصة بهم."
 ],
