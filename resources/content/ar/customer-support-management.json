 "overview": [
  "تتطلب الإدارة الفعالة لدعم العملاء أكثر من مجرد حل الطلبات الفردية. يتطلب نهج تشغيل منظمًا يربط احتياجات العملاء وقنوات الدعم والأشخاص والعمليات ومعايير الخدمة والتكنولوجيا والتصعيد والمعرفة وقياس الأداء والتحسين المستمر. عندما تعمل هذه العناصر معًا، يمكن لفرق الدعم تقديم خدمة موثوقة مع التحكم في عبء العمل وتحسين جودة الدقة وتعزيز تجربة العملاء الشاملة.",
  "تزود هذه الدورة المديرين والمشرفين وقادة الفرق بأساليب عملية لتنظيم وإدارة عمليات دعم العملاء. سيتعلم المشاركون كيفية تحديد معايير الخدمة، وتنظيم سير عمل الدعم، وإدارة قوائم الانتظار والأولويات، وتحسين حل الاتصال الأول، وإنشاء عمليات التصعيد، وبناء موارد معرفية مفيدة، وتدريب موظفي الدعم، والتعامل مع الحالات الصعبة، ومراقبة أداء الخدمة، واستخدام بيانات دعم العملاء لتحسين العمليات والقرارات.",
  "يجمع البرنامج بين الإدارة التشغيلية ومبادئ تجربة العملاء. سيعمل المشاركون من خلال سيناريوهات الدعم، وتحليل سير العمل، وتمارين مستوى الخدمة، وحالات التصعيد، ومقاييس الأداء، وحالات التدريب، وتخطيط التحسين لتطوير نهج عملي لقيادة فرق الدعم سريعة الاستجابة والمتسقة والتي تركز على العملاء."
 ],
 "audience": [
  "مديرو دعم العملاء، ومديرو خدمة العملاء، والمشرفون، وقادة الفرق، وقادة مراكز الاتصال، ومديرو مكتب المساعدة، وموظفو مكتب الخدمة، ومديرو الفروع والعمليات، ومتخصصو تجربة العملاء، وموظفو جودة الخدمة، والموظفون المسؤولون عن إدارة طلبات العملاء، وفرق الدعم، ومستويات الخدمة، والتصعيد، أو أداء الدعم."
 ],
 "methodology": [
  "تستخدم الدورة منهجية تفاعلية تجمع بين العروض التقديمية القصيرة، ودراسات حالة دعم العملاء، ورسم خرائط سير العمل، وتمارين مستوى الخدمة، وسيناريوهات الانتظار وتحديد الأولويات، ومحاكاة التصعيد، والشكاوى وحالات العملاء الصعبة، وأنشطة قياس الأداء، وتمارين التدريب، وتحليل السبب الجذري، والمناقشات الجماعية، وتخطيط العمل. سيقوم المشاركون بتطبيق الأدوات على بيئات الدعم الواقعية وتطوير التحسينات العملية ذات الصلة بعملياتهم الخاصة."
 ],
