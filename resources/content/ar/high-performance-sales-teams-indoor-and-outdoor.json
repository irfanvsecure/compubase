{
 "duration": "5 أيام",
 "overview": [
  "وتجمع أفرقة المبيعات ذات الأداء العالي بين استراتيجية تجارية واضحة، وقيادة فعالة، وعمليات مقسمة للمبيعات، وعلاقات عملاء قوية، والتنفيذ المتسق. وتواجه أفرقة المبيعات الداخلية وأفرقة المبيعات الميدانية الخارجية ظروفا تشغيلية مختلفة، ومع ذلك يجب على كل منهما تحويل الفرص إلى أعمال مربحة مع توفير خبرة عملاء موثوق بها.",
  "وتزود هذه الدورة التي تستغرق خمسة أيام مديري المبيعات والمشرفين وقادة الأفرقة بأساليب عملية لبناء وإدارة فرق مبيعات عالية الأداء داخل المباني وخارجها. ويدرس المشاركون تخطيط المبيعات، وتغطية الأراضي والحسابات، والإدارة الرائدة، والانضباط في خطوط الأنابيب، وهياكل الأفرقة، والتوظيف، والالتحاق، والتوجيه، والحوافز، ومقاييس الأداء، والإنتاجية الميدانية، والفعالية داخل المبيعات، والتنسيق بين القنوات.",
  "ومن خلال حالات المبيعات، والتمرينات التي يقوم بها برنامج كيمبرلي، وحلقات العمل المتعلقة بتخطيط الأراضي، وعمليات محاكاة المكالمات والزيارات، وممارسة التدريب، وتشخيص أداء الأفرقة، وتخطيط العمل، يطور المشاركون المهارات اللازمة لتعزيز إنتاجية المبيعات، والمساءلة، والتعاون، والنتائج المستدامة."
 ],
 "audience": [
  "مديرو المبيعات، ومديرو المبيعات على الصعيدين الإقليمي والمحلي، والمشرفون على المبيعات في الأماكن المغلقة، والمشرفون على المبيعات الميدانية، وقادة الأفرقة، ومديرو تطوير الأعمال التجارية، وأخصائيو عمليات المبيعات، ومديرو الحسابات الرئيسية، والمهنيون المسؤولون عن إدارة أفرقة المبيعات أو تدريبها أو تنسيقها داخلها وخارجها."
 ],
 "methodology": [
  "عروض تفاعلية، ودراسات حالة أداء تجارية، ورسم خرائط لعمليات البيع، وحلقات عمل لتصميم الأفرقة والأقاليم، وتحليل عملية كيمبرلي وخطوط الأنابيب، ودور الطلب على العملاء والفحص الميداني، وتدريب المحاكاة، ومناقشات تحديد الحوافز، وعمليات التنبؤ، والتخطيط التعاوني، ووضع خطة عمل عملية."
 ],
