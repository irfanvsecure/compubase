<IfModule mod_rewrite.c>
    RewriteEngine On

    # Already at the front controller.
    RewriteRule ^public/index\.php$ - [L]

    # CSS and JS live next to this file, outside public/.
    RewriteRule ^(css|js)/ - [L]

    # Send every page to Laravel. Rewriting /about to public/about 404s on
    # LiteSpeed, because public/about is not a real file.
    RewriteRule ^ public/index.php [L]
</IfModule>
