<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header through to Laravel.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # CSS, JS, images and uploaded images live next to this file, outside public/.
    RewriteRule ^(css|js|images|uploads)/ - [L]

    # Already inside public/ (front controller or a real file there).
    RewriteRule ^public/ - [L]

    # Real files that live in public/. robots.txt and sitemap.xml are built
    # by Laravel from the site settings, so they go to the front controller.
    RewriteRule ^(favicon\.ico)$ public/$1 [L]

    # Send every page straight to Laravel. Rewriting /about to public/about
    # 404s on LiteSpeed, because public/about is not a real file and
    # LiteSpeed does not re-run public/.htaccess after the rewrite.
    # No RewriteBase: this works both in /compubase on XAMPP and at the domain root.
    RewriteRule ^ public/index.php [L]
</IfModule>
